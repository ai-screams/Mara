<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 번들 정체성 키. 사용자 지정 Info.plist라 Xcode가 대신 넣어 주지 않는다. CFBundleExecutable이 없으면
         실행 파일을 번들 이름으로 찾아, 이름이 바뀐 사본(Finder "둘 다 유지"의 "Mara 2.app")은 서명이 없는
         코드로 판정된다. CFBundlePackageType이 없으면 PkgInfo가 ????????가 되어 spctl이 앱으로 보지 않는다. -->
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>Mara</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleName</key><string>Mara</string>
    <key>CFBundleIdentifier</key><string>com.aiscream.Mara</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSUIElement</key><true/>
    <!-- Sparkle 자동 업데이트. 개인키는 유지보수자 Keychain(account "Mara")과 release 환경
         CI secret에만 있고 공개키만 여기 내장. 피드는 최신 GitHub Release 자산(고정 리다이렉트 URL). -->
    <key>SUFeedURL</key><string>https://github.com/ai-screams/Mara/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key><string>pyd1gAyhq+RAtlk6plyWdF6tiWtzWvBIjDwzy3JVNbI=</string>
</dict>
</plist>
