<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  릴리스 전용 entitlements. export 뒤 scripts/embed-release-entitlements.sh가 적용한다(#91).
  macOS 27은 이 entitlement가 없는 프로세스에 ARP(neighbor) 테이블을 비워 돌려줘서, 네트워크 트리거가
  게이트웨이 MAC을 읽지 못한다. 제한 키라 "Mara Developer ID" 프로비저닝 프로파일이 앱에 들어 있어야 하고,
  프로파일 없이 선언한 빌드는 실행 즉시 종료된다. 그래서 project.yml에 연결하지 않는다 — 로컬 Apple
  Development 빌드가 실행되지 않게 된다.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.networking.topology-observation</key>
    <true/>
</dict>
</plist>
